// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model User {
  id         String     @id @default(uuid())
  email      String     @unique
  name       String?
  businesses Business[]

  disabled  Boolean   @default(false)
  deletedAt DateTime?

  bookingsCreated       Booking[]        @relation("BookingCreatedBy")
  bookingHistoryActions BookingHistory[] @relation("BookingHistoryActor")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([name])
}

model Business {
  id          String  @id @default(uuid())
  name        String
  slug        String  @unique
  description String?
  tagline     String?
  phone       String?
  email       String?
  address     String?
  timezone    String  @default("Africa/Cairo")
  isActive    Boolean @default(true)
  currency    String  @default("EGP")

  defaultDurationMinutes     Int @default(30)
  defaultSlotIntervalMinutes Int @default(30)
  defaultCapacity            Int @default(1)

  owner   User   @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  ownerId String

  bookings                       Booking[]
  services                       Service[]
  businessWorkingDays            BusinessWorkingDay[]
  businessAvailabilityExceptions BusinessAvailabilityException[]

  disabled  Boolean   @default(false)
  deletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([name])
  @@index([phone])
  @@index([ownerId])
}

model Service {
  id          String  @id @default(uuid())
  name        String
  description String?
  imageUrl    String?
  price       Decimal @db.Decimal(10, 2)

  durationMinutes     Int?
  slotIntervalMinutes Int?
  capacity            Int?

  isActive Boolean @default(true)

  bookings   Booking[]
  business   Business  @relation(fields: [businessId], references: [id], onDelete: Restrict)
  businessId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([id, businessId])
  @@index([businessId, name])
}

model BusinessWorkingDay {
  id      String  @id @default(uuid())
  weekday Weekday

  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  businessId String

  periods BusinessWorkingPeriod[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([businessId, weekday])
}

model BusinessWorkingPeriod {
  id          String   @id @default(uuid())
  startTime   DateTime @db.Time(0)
  endTime     DateTime @db.Time(0)
  endsNextDay Boolean  @default(false)

  workingDay   BusinessWorkingDay @relation(fields: [workingDayId], references: [id], onDelete: Cascade)
  workingDayId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([workingDayId])
}

model BusinessAvailabilityException {
  id         String                    @id @default(uuid())
  date       DateTime                  @db.Date
  type       AvailabilityExceptionType
  changeMode AvailabilityChangeMode
  reason     String?

  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  businessId String

  periods BusinessExceptionPeriod[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([businessId, date])
}

model BusinessExceptionPeriod {
  id          String   @id @default(uuid())
  startTime   DateTime @db.Time(0)
  endTime     DateTime @db.Time(0)
  endsNextDay Boolean  @default(false)

  exception   BusinessAvailabilityException @relation(fields: [exceptionId], references: [id], onDelete: Cascade)
  exceptionId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([exceptionId])
}

model Booking {
  id            String @id @default(uuid())
  bookingNumber String @unique

  // Customer information
  customerName  String
  customerEmail String
  customerPhone String

  // Booking ownership
  business   Business @relation(fields: [businessId], references: [id], onDelete: Restrict)
  businessId String

  service   Service @relation(fields: [serviceId, businessId], references: [id, businessId], onDelete: Restrict)
  serviceId String

  // Service snapshots at booking time
  serviceNameSnapshot     String
  servicePriceSnapshot    Decimal @db.Decimal(10, 2)
  serviceDurationSnapshot Int
  currencySnapshot        String

  // Appointment time (UTC)
  startAt DateTime @db.Timestamptz(3)
  endAt   DateTime @db.Timestamptz(3)

  // Status
  status BookingStatus @default(CONFIRMED)

  // Cancellation
  cancellationReason String?
  cancelledAt        DateTime? @db.Timestamptz(3)

  // Booking source
  source BookingSource @default(CUSTOMER)

  createdByUser   User?   @relation("BookingCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  createdByUserId String?

  // Related records
  history    BookingHistory[]
  accessOtps BookingAccessOtp[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([businessId, startAt])
  @@index([serviceId, startAt])
  @@index([customerEmail])
  @@index([status, startAt])
}

model BookingHistory {
  id String @id @default(uuid())

  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  bookingId String

  action    BookingHistoryAction
  actorType BookingHistoryActorType

  actorUser   User?   @relation("BookingHistoryActor", fields: [actorUserId], references: [id], onDelete: Restrict)
  actorUserId String?

  // Previous appointment time
  previousStartAt DateTime? @db.Timestamptz(3)
  previousEndAt   DateTime? @db.Timestamptz(3)

  // New appointment time
  newStartAt DateTime? @db.Timestamptz(3)
  newEndAt   DateTime? @db.Timestamptz(3)

  // Status transition
  previousStatus BookingStatus?
  newStatus      BookingStatus?

  reason String?

  createdAt DateTime @default(now())

  @@index([bookingId, createdAt])
  @@index([actorUserId])
}

model BookingAccessOtp {
  id String @id @default(uuid())

  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  bookingId String

  // Never store the OTP itself
  codeHash String

  expiresAt     DateTime  @db.Timestamptz(3)
  consumedAt    DateTime? @db.Timestamptz(3)
  invalidatedAt DateTime? @db.Timestamptz(3)

  attempts Int @default(0)

  createdAt DateTime @default(now())

  @@index([bookingId, createdAt])
  @@index([expiresAt])
}

enum Weekday {
  SATURDAY
  SUNDAY
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
}

enum AvailabilityExceptionType {
  CLOSED
  CUSTOM_HOURS
}

enum AvailabilityChangeMode {
  PLANNED
  EMERGENCY
}

enum BookingStatus {
  CONFIRMED
  CANCELLED
  COMPLETED
  NO_SHOW
}

enum BookingSource {
  CUSTOMER
  BUSINESS_OWNER
}

enum BookingHistoryActorType {
  CUSTOMER
  BUSINESS_OWNER
  SYSTEM
}

enum BookingHistoryAction {
  CREATED
  RESCHEDULED
  CANCELLED
  COMPLETED
  NO_SHOW
}
