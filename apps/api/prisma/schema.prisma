// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model User {
  id         String     @id @default(uuid())
  email      String     @unique
  name       String?
  businesses Business[]

  disabled  Boolean   @default(false)
  deletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([name])
}

model Business {
  id          String  @id @default(uuid())
  name        String
  slug        String  @unique
  description String?
  tagline     String?
  phone       String?
  email       String?
  address     String?
  timezone    String  @default("Africa/Cairo")
  isActive    Boolean @default(true)
  currency    String  @default("EGP")

  defaultDurationMinutes     Int @default(30)
  defaultSlotIntervalMinutes Int @default(30)
  defaultCapacity            Int @default(1)

  owner   User   @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  ownerId String

  services                       Service[]
  businessWorkingDays            BusinessWorkingDay[]
  businessAvailabilityExceptions BusinessAvailabilityException[]

  disabled  Boolean   @default(false)
  deletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([name])
  @@index([phone])
  @@index([ownerId])
}

model Service {
  id          String  @id @default(uuid())
  name        String
  description String?
  imageUrl    String?
  price       Decimal @db.Decimal(10, 2)

  durationMinutes     Int?
  slotIntervalMinutes Int?
  capacity            Int?

  isActive Boolean @default(true)

  business   Business @relation(fields: [businessId], references: [id], onDelete: Restrict)
  businessId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([businessId, name])
}

model BusinessWorkingDay {
  id      String  @id @default(uuid())
  weekday Weekday

  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  businessId String

  periods BusinessWorkingPeriod[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([businessId, weekday])
}

model BusinessWorkingPeriod {
  id          String   @id @default(uuid())
  startTime   DateTime @db.Time(0)
  endTime     DateTime @db.Time(0)
  endsNextDay Boolean  @default(false)

  workingDay   BusinessWorkingDay @relation(fields: [workingDayId], references: [id], onDelete: Cascade)
  workingDayId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([workingDayId])
}

model BusinessAvailabilityException {
  id         String                    @id @default(uuid())
  date       DateTime                  @db.Date
  type       AvailabilityExceptionType
  changeMode AvailabilityChangeMode
  reason     String?

  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  businessId String

  periods BusinessExceptionPeriod[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([businessId, date])
}

model BusinessExceptionPeriod {
  id          String   @id @default(uuid())
  startTime   DateTime @db.Time(0)
  endTime     DateTime @db.Time(0)
  endsNextDay Boolean  @default(false)

  exception   BusinessAvailabilityException @relation(fields: [exceptionId], references: [id], onDelete: Cascade)
  exceptionId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([exceptionId])
}

enum Weekday {
  SATURDAY
  SUNDAY
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
}

enum AvailabilityExceptionType {
  CLOSED
  CUSTOM_HOURS
}

enum AvailabilityChangeMode {
  PLANNED
  EMERGENCY
}
